# Copy to .env and fill in real values:  cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit real credentials.
# Generate random secrets with:  openssl rand -base64 36

# ==============================
# GENERAL
# ==============================
DOMAIN=example.com                              # Apex domain; subdomains: www, mail, cloud, office, pass, status, portainer
ACME_EMAIL=admin@example.com                    # Let's Encrypt expiry notices (Caddy)
TZ=Europe/Istanbul

# ==============================
# NEXTCLOUD (+ POSTGRESQL, REDIS)
# ==============================
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=CHANGE_ME
NC_DB_USER=nextcloud
NC_DB_PASSWORD=CHANGE_ME
NC_DB_NAME=nextcloud
REDIS_PASSWORD=CHANGE_ME

# ==============================
# ONLYOFFICE
# ==============================
ONLYOFFICE_JWT_SECRET=CHANGE_ME                 # Also entered in Nextcloud > Administration > ONLYOFFICE

# ==============================
# WEB SITE (WORDPRESS + MARIADB)
# ==============================
WP_DB_ROOT_PASSWORD=CHANGE_ME
WP_DB_USER=wordpress
WP_DB_PASSWORD=CHANGE_ME
WP_DB_NAME=wordpress

# ==============================
# VAULTWARDEN
# ==============================
VW_SIGNUPS_ALLOWED=false                        # true only while creating the first accounts
# Prefer an Argon2 hash:  docker run --rm -it vaultwarden/server:1.37.4 /vaultwarden hash
# Wrap the hash in single quotes so Compose does not interpolate its '$' signs.
VW_ADMIN_TOKEN=CHANGE_ME
