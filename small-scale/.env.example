# Copy to .env and fill in real values:  cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit real credentials.
# Generate random secrets with:  openssl rand -base64 36

# ==============================
# CLOUDFLARE INGRESS
# ==============================
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME               # Cloudflare Zero Trust > Tunnels > token

# ==============================
# SAMBA AD (CORE IDENTITY)
# ==============================
SAMBA_DOMAIN=corp.sovereign.local               # Local veya external domain adiniz
SAMBA_ADMIN_PASSWORD=CHANGE_ME
SAMBA_HOST_IP=10.0.0.10                         # Ana sunucunun lokal IP'si (DNS yonlendirmeleri icin)

# ==============================
# AUTHENTIK (SSO / IDP)
# ==============================
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=CHANGE_ME
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_SECRET_KEY=CHANGE_ME                  # openssl rand -base64 60

# ==============================
# NEXTCLOUD
# ==============================
NEXTCLOUD_DATA_DIR=/mnt/data/nextcloud_data     # Opsiyonel: verilerin ana diskte kalacagi yer
NEXTCLOUD_DB_PASSWORD=CHANGE_ME                 # docker-compose.aio.yml
NEXTCLOUD_DB_ROOT_PASSWORD=CHANGE_ME            # docker-compose.aio.yml

# ==============================
# MAILCOW (RSPAMD & CORE DB)
# ==============================
MAILCOW_DB_ROOT_PASSWORD=CHANGE_ME
MAILCOW_DB_NAME=mailcow
MAILCOW_DB_USER=mailcow
MAILCOW_DB_PASSWORD=CHANGE_ME

# ==============================
# WAZUH SOC
# ==============================
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=CHANGE_ME
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME

# ==============================
# FILE SHARE (docker-compose.aio.yml)
# ==============================
SMB_SHARE_USER=share
SMB_SHARE_PASSWORD=CHANGE_ME

# ==============================
# GRAFANA (docker-compose.aio.yml)
# ==============================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
