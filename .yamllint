---
extends: default

ignore: |
  website/
  small-scale/mailcow/
  infrastructure/templates/

rules:
  new-lines: disable  # Git normalises line endings per platform
  document-start: disable
  line-length:
    max: 160
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  indentation:
    spaces: 2
    indent-sequences: whatever
